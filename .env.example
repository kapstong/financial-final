# Single runtime env file for both local and production.
# Copy this to /.env and set APP_ENV / APP_URL for the target server.
APP_ENV=development
APP_NAME=ATIERA Finance
APP_URL=http://localhost
APP_KEY=base64:replace-with-a-random-32-byte-key

DB_HOST=localhost
DB_NAME=fina_financialmngmnt
DB_USER=root
DB_PASS=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=ATIERA Finance

UPLOAD_PATH=uploads/
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png

SESSION_LIFETIME=7200
CSRF_TOKEN_LIFETIME=3600
LOGIN_ATTEMPTS_MAX=5
LOCKOUT_DURATION=300
TWOFA_ATTEMPTS_MAX=5
TWOFA_LOCKOUT_HOURS=1
ALLOW_SSO_GET_TOKENS=false

API_RATE_LIMIT=100
API_KEY=
API_ALLOW_QUERY_KEY=false

LOG_LEVEL=error
LOG_FILE=logs/app.log

BACKUP_PATH=backups/
BACKUP_RETENTION_DAYS=30

DEFAULT_CURRENCY=PHP
CURRENCY_SYMBOL=PHP

COMPANY_NAME=ATIERA Hotel & Restaurant
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=info@example.com

CUSTOMER_SERVICE_URL=
CUSTOMER_SERVICE_API_KEY=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
